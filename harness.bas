10 REM =========================================================
20 REM WBASIC REGRESSION HARNESS (CLEAN FULL LISTING)
30 REM - All lines numbered, REM-only comments
40 REM - Self-check validates ON ERROR handler reachable
50 REM - Avoids OPTION BASE after DIM
60 REM - Includes NEXT varlist test (NEXT J,I)
70 REM - DEF FN params avoid array-name collisions
80 REM =========================================================
90 CLS
100 PRINT "WBASIC REGRESSION HARNESS"
110 PRINT "========================="
120 PRINT

130 FAIL=0
140 PASS=0
150 TESTNO=0

160 REM --- Trap + expectation state ---
170 ON ERROR GOTO 9000
180 WANT_ACTIVE=0
190 WANTERR=-1
200 WANTERL=-1
210 AFTERLINE=0
220 RESMODE=0
230 TRIP=0
240 GOTERR=0
250 GOTERL=0

260 REM --- Run tests ---
270 GOSUB 1000
280 GOSUB 2000
290 GOSUB 3000
300 GOSUB 4000
310 GOSUB 5000
320 GOSUB 6000
330 GOSUB 7000
340 GOSUB 8000
350 GOSUB 8500

360 PRINT
370 PRINT "========================="
380 PRINT "HARNESS COMPLETE"
390 PRINT "PASS=";PASS;"  FAIL=";FAIL
400 PRINT "========================="
410 END

500 REM --- Begin a test ---
510 TESTNO=TESTNO+1
520 PRINT
530 PRINT "TEST";TESTNO;":";TITLE$
540 RETURN

560 REM --- Assert numeric equality ---
570 IF ACT=EXP THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  expected";EXP;" got";ACT
580 RETURN

600 REM --- Assert string equality ---
610 IF ACT$=EXP$ THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  expected [";EXP$;"] got [";ACT$;"]"
620 RETURN

650 REM --- Arm an expected error event ---
660 GOTERR=0: GOTERL=0: TRIP=0
670 WANT_ACTIVE=1
680 RETURN

1000 REM =====================================================
1010 REM TEST 1: SELF-CHECK (drift-proof)
1020 REM =====================================================
1030 TITLE$="SELF-CHECK: ON ERROR handler reachable"
1040 GOSUB 500
1050 WANTERR=11: WANTERL=0: AFTERLINE=1160: RESMODE=2: GOSUB 650
1060 PRINT "  Triggering DIV/0 to confirm trap..."
1070 A=1
1080 A=A/0
1090 PRINT "  SHOULD NOT SEE"
1160 IF GOTERR=11 AND GOTERL>0 THEN PASS=PASS+1: PRINT "  RESULT: PASS  GOTERR/GOTERL=";GOTERR;GOTERL ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  GOTERR/GOTERL=";GOTERR;GOTERL
1170 WANT_ACTIVE=0: WANTERR=-1: WANTERL=-1: AFTERLINE=0: RESMODE=0
1180 RETURN

2000 REM =====================================================
2010 REM TEST 2: Colon chains + IF/ELSEIF + Block IF
2020 REM =====================================================
2030 TITLE$="Colon chains + IF/ELSEIF + Block IF"
2040 GOSUB 500

2050 A1=1: B1=2: C1=0
2060 A1=A1+1: B1=B1+1: C1=A1+B1: PRINT "  A,B,C expected 2,3,5 ->";A1;B1;C1
2070 ACT=A1*100+B1*10+C1: EXP=235
2080 GOSUB 560

2090 S$="x"
2100 R$=""
2110 IF S$="y" THEN
2120   R$="THEN"
2130 ELSEIF S$="x" THEN
2140   R$="ELSEIF"
2150 ELSE
2160   R$="ELSE"
2170 END IF
2180 ACT$=R$: EXP$="ELSEIF"
2190 PRINT "  ELSEIF expected ELSEIF ->";ACT$
2200 GOSUB 600

2210 X1=0
2220 IF 1=1 THEN
2230   X1=10
2240 ELSE
2250   X1=99
2260 END IF
2270 ACT=X1: EXP=10
2280 PRINT "  Block IF expected 10 ->";ACT
2290 GOSUB 560
2300 RETURN

3000 REM =====================================================
3010 REM TEST 3: ON ERROR / RESUME variants
3020 REM =====================================================
3030 TITLE$="ON ERROR / RESUME variants"
3040 GOSUB 500

3050 WANTERR=11: WANTERL=0: AFTERLINE=3160: RESMODE=1: GOSUB 650
3060 PRINT "  Expect DIV/0 trapped, RESUME NEXT"
3070 X=1
3080 X=1/0
3090 PRINT "  After RESUME NEXT (should print) X=";X
3160 IF GOTERR=11 AND GOTERL>0 THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  GOTERR/GOTERL=";GOTERR;GOTERL

3170 WANTERR=11: WANTERL=0: AFTERLINE=3280: RESMODE=2: GOSUB 650
3180 PRINT "  Expect DIV/0 trapped, RESUME to 3280"
3190 Y=5
3200 Y=Y/0
3210 PRINT "  SHOULD NOT SEE"
3280 PRINT "  After RESUME <line> (should print) Y=";Y
3290 IF GOTERR=11 AND GOTERL>0 THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  GOTERR/GOTERL=";GOTERR;GOTERL

3300 WANTERR=11: WANTERL=0: AFTERLINE=3410: RESMODE=0: GOSUB 650
3310 PRINT "  Expect DIV/0 trapped, RESUME repeats once then jumps"
3320 Z=9
3330 Z=Z/0
3340 PRINT "  SHOULD NOT SEE"
3410 PRINT "  After RESUME (should print) Z=";Z
3420 IF GOTERR=11 AND GOTERL>0 THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  GOTERR/GOTERL=";GOTERR;GOTERL

3430 WANT_ACTIVE=0: WANTERR=-1: WANTERL=-1: AFTERLINE=0: RESMODE=0
3440 RETURN

4000 REM =====================================================
4010 REM TEST 4: OPTION BASE 0 + LBOUND/UBOUND (BASE 0 ONLY)
4020 REM =====================================================
4030 TITLE$="OPTION BASE 0 + LBOUND/UBOUND"
4040 GOSUB 500
4050 OPTION BASE 0
4060 DIM ARR0(5)
4070 ACT=LBOUND(ARR0): EXP=0
4080 PRINT "  LBOUND expected 0 ->";ACT
4090 GOSUB 560
4100 ACT=UBOUND(ARR0): EXP=5
4110 PRINT "  UBOUND expected 5 ->";ACT
4120 GOSUB 560
4130 RETURN

5000 REM =====================================================
5010 REM TEST 5: FOR/NEXT fidelity (includes NEXT varlist)
5020 REM =====================================================
5030 TITLE$="FOR/NEXT fidelity"
5040 GOSUB 500

5050 S=0
5060 FOR I=1 TO 3
5070   S=S+I
5080 NEXT I
5090 ACT=S: EXP=6
5100 PRINT "  Sum 1..3 expected 6 ->";ACT
5110 GOSUB 560

5120 REM Nested loops standard NEXT
5130 CNT=0
5140 FOR I=1 TO 2
5150   FOR J=1 TO 2
5160     CNT=CNT+1
5170   NEXT J
5180 NEXT I
5190 ACT=CNT: EXP=4
5200 PRINT "  Nested loops expected 4 ->";ACT
5210 GOSUB 560

5220 REM Nested loops NEXT varlist (NEXT J,I)
5230 CNT=0
5240 FOR I=1 TO 2
5250   FOR J=1 TO 2
5260     CNT=CNT+1
5270   NEXT J,I
5280 ACT=CNT: EXP=4
5290 PRINT "  NEXT J,I expected 4 ->";ACT
5300 GOSUB 560
5310 RETURN

6000 REM =====================================================
6010 REM TEST 6: DO/LOOP + EXIT DO
6020 REM =====================================================
6030 TITLE$="DO/LOOP + EXIT DO"
6040 GOSUB 500

6050 C=0
6060 DO
6070   C=C+1
6080   IF C=3 THEN EXIT DO
6090 LOOP
6100 ACT=C: EXP=3
6110 PRINT "  Count expected 3 ->";ACT
6120 GOSUB 560
6130 RETURN

7000 REM =====================================================
7010 REM TEST 7: FILE I/O
7020 REM =====================================================
7030 TITLE$="FILE I/O"
7040 GOSUB 500

7050 F$="wbasic_harness_tmp.txt"
7060 OPEN F$ FOR OUTPUT AS #1
7070 PRINT #1,"123"
7080 PRINT #1,"HELLO"
7090 CLOSE #1
7100 OPEN F$ FOR INPUT AS #1
7110 INPUT #1,N
7120 LINE INPUT #1,S2$
7130 E=EOF(1)
7140 CLOSE #1

7150 ACT=N: EXP=123
7160 PRINT "  INPUT# expected 123 ->";ACT
7170 GOSUB 560
7180 ACT$=S2$: EXP$="HELLO"
7190 PRINT "  LINE INPUT# expected HELLO ->";ACT$
7200 GOSUB 600
7210 ACT=E: EXP=-1
7220 PRINT "  EOF expected -1 ->";ACT
7230 GOSUB 560
7240 RETURN

8000 REM =====================================================
8010 REM TEST 8: DEF FN runtime
8020 REM =====================================================
8030 TITLE$="DEF FN runtime"
8040 GOSUB 500

8050 DEF FNSUM(P,Q)=P+Q
8060 DEF FNDOUBLE(R)=R*2
8070 DEF FNNEST(R)=FNDOUBLE(R)+1
8080 ACT=FNSUM(2,3): EXP=5
8090 PRINT "  FNSUM expected 5 ->";ACT
8100 GOSUB 560
8110 ACT=FNNEST(4): EXP=9
8120 PRINT "  FNNEST expected 9 ->";ACT
8130 GOSUB 560

8140 DEF FNJOIN$(S1$,S2$,S3$)=S1$+"-"+S2$+"-"+S3$
8150 ACT$=FNJOIN$("A","B","C"): EXP$="A-B-C"
8160 PRINT "  FNJOIN$ expected A-B-C ->";ACT$
8170 GOSUB 600

8180 DEF FNBRACK$(U$)="["+U$+"]"
8190 DEF FNWRAP$(U$)="<"+FNBRACK$(U$)+">"
8200 ACT$=FNWRAP$("Q"): EXP$="<[Q]>"
8210 PRINT "  FNWRAP$ expected <[Q]> ->";ACT$
8220 GOSUB 600
8230 RETURN

8500 REM =====================================================
8510 REM TEST 9: Subscript out of range trap (expects ERR=9)
8520 REM =====================================================
8530 TITLE$="Subscript out of range ERR/ERL"
8540 GOSUB 500

8550 DIM Z(2)
8560 WANTERR=9: WANTERL=0: AFTERLINE=8620: RESMODE=2: GOSUB 650
8570 Z(99)=1
8580 PRINT "  SHOULD NOT SEE"
8620 IF GOTERR=9 AND GOTERL>0 THEN PASS=PASS+1: PRINT "  RESULT: PASS" ELSE FAIL=FAIL+1: PRINT "  RESULT: FAIL  GOTERR/GOTERL=";GOTERR;GOTERL
8630 WANT_ACTIVE=0: WANTERR=-1: WANTERL=-1: AFTERLINE=0: RESMODE=0
8640 RETURN

9000 REM =====================================================
9010 REM CENTRAL ERROR HANDLER
9020 REM WANTERL=0 means accept any ERL>0 (drift-proof)
9030 REM =====================================================
9040 GOTERR=ERR
9050 GOTERL=ERL
9060 PRINT ">> HANDLER ERR=";ERR;" ERL=";ERL
9070 IF WANT_ACTIVE=0 THEN PRINT "UNEXPECTED ERROR";ERR;"AT";ERL: END
9080 IF ERR<>WANTERR THEN PRINT "WRONG ERR";ERR;"EXPECTED";WANTERR: END
9090 IF WANTERL<>0 THEN IF ERL<>WANTERL THEN PRINT "WRONG ERL";ERL;"EXPECTED";WANTERL: END
9100 IF RESMODE=1 THEN RESUME NEXT
9110 IF RESMODE=2 THEN RESUME AFTERLINE
9120 TRIP=TRIP+1
9130 IF TRIP=1 THEN RESUME
9140 RESUME AFTERLINE
