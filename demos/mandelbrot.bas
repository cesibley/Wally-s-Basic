10 REM MANDELBROT SET - TEXT MODE (PROMPT ITERATIONS)
20 CLS
30 INPUT "Max iterations (e.g. 15, 25, 40)"; M
40 IF M < 1 THEN M = 15
50 CLS
60 FOR Y = -12 TO 12
70 FOR X = -39 TO 39
80 CA = X * 0.0458
90 CB = Y * 0.08333
100 A = CA
110 B = CB
120 I = 0
130 IF A*A + B*B > 4 THEN GOTO 200
140 IF I >= M THEN GOTO 200
150 T = A*A - B*B + CA
160 B = 2*A*B + CB
170 A = T
180 I = I + 1
190 GOTO 130
200 IF I >= M THEN PRINT "*"; ELSE PRINT " ";
210 NEXT X
220 PRINT
230 NEXT Y
240 END
