10 REM PI CALCULATION TEST (WBASIC FRIENDLY)
20 INPUT "NUMBER OF ITERATIONS "; N

30 T0 = TIMER()
40 PI = 0
50 SIGN = 1

60 FOR I = 0 TO N - 1
70 TERM = SIGN / (2 * I + 1)
80 PI = PI + TERM
90 SIGN = -SIGN
100 NEXT I

110 PI = PI * 4
120 T1 = TIMER()
130 ELAPSED = T1 - T0
140 IF ELAPSED < 0 THEN ELAPSED = ELAPSED + 86400

150 PRINT
160 PRINT "CALCULATED PI = "; PI
170 PRINT "ITERATIONS    = "; N
180 PRINT "ELAPSED TIME  = "; ELAPSED; " SECONDS"
190 END
