10 REM ==========================================================
20 REM JULIA SET FRACTAL (TEXT MODE) - GW-BASIC / WBASIC
30 REM Fixed parameter C = -0.8 + 0.156i
40 REM Compatible with WBASIC CLI and UI builds
50 REM ==========================================================
60 CLS
70 PRINT "JULIA SET FRACTAL"
80 PRINT "C = -0.8 + 0.156I"
90 PRINT
100 INPUT "MAX ITERATIONS (SUGGEST 16 TO 40)"; M
110 IF M < 1 THEN M = 24
120 CLS
130 PRINT "JULIA SET  C = -0.8 + 0.156I  ITER="; M
140 PRINT
150 CR = -0.8
160 CI = 0.156
170 FOR PY = -12 TO 12
180   Y0 = PY * 0.08333
190   FOR PX = -39 TO 39
200     X0 = PX * 0.0458
210     X = X0
220     Y = Y0
230     I = 0
240     WHILE X*X + Y*Y <= 4 AND I < M
250       XT = X*X - Y*Y + CR
260       Y = 2*X*Y + CI
270       X = XT
280       I = I + 1
290     WEND
300     IF I >= M THEN GOSUB 1000: GOTO 380
310     IF I > M * .9 THEN GOSUB 1010: GOTO 380
320     IF I > M * .75 THEN GOSUB 1020: GOTO 380
330     IF I > M * .6 THEN GOSUB 1030: GOTO 380
340     IF I > M * .45 THEN GOSUB 1040: GOTO 380
350     IF I > M * .3 THEN GOSUB 1050: GOTO 380
360     IF I > M * .15 THEN GOSUB 1060: GOTO 380
370     GOSUB 1070
380   NEXT PX
390   PRINT
400 NEXT PY
410 PRINT
420 PRINT "DONE"
430 END
1000 PRINT "*";: RETURN
1010 PRINT "@";: RETURN
1020 PRINT "#";: RETURN
1030 PRINT "o";: RETURN
1040 PRINT "+";: RETURN
1050 PRINT "=";: RETURN
1060 PRINT ".";: RETURN
1070 PRINT " ";: RETURN
