10 REM ==================================================
20 REM WBASIC GRAPHICS COLOR PATTERN (ALL SCREEN MODES)
30 REM Cycles SCREEN 1,2,3,7,8,9,10,11,12,13
40 REM Shows mode + nominal resolution and color blocks
50 REM ==================================================
60
70 FOR I = 1 TO 10
80   READ M, W, H
90   SCREEN M
95   IF M = 1 THEN COLOR 0,1
100  CLS
110
120  BW = W \ 4
130  BH = H \ 4
140
150  FOR C = 0 TO 15
152    IF M = 1 AND C >= 4 THEN 260
155    DC = C
156    IF M = 1 THEN DC = C AND 3
160    X = (C MOD 4) * BW
170    Y = (C \ 4) * BH
180    LINE (X,Y)-(X+BW-1,Y+BH-1), DC, BF
190
200    IF C < 8 THEN FC = 15 ELSE FC = 0
210    IF M <> 1 THEN COLOR FC, DC
220    R = (C \ 4) * 6 + 3
230    K = (C MOD 4) * 20 + 3
240    LOCATE R, K
250    PRINT "COLOR"; DC
260  NEXT C
270
280  IF M = 1 THEN COLOR 0,1 ELSE COLOR 15,0
290  LOCATE 24,1
300  PRINT "SCREEN"; M; "  RES:"; W; "x"; H
310  LOCATE 25,1
320  PRINT "PRESS ANY KEY FOR NEXT MODE"
330
340  K$ = INKEY$: IF K$ = "" THEN 340
350 NEXT I
360
370 SCREEN 0
380 END
390
400 DATA 1,320,200
410 DATA 2,640,200
420 DATA 3,640,400
430 DATA 7,320,200
440 DATA 8,640,200
450 DATA 9,640,350
460 DATA 10,640,350
470 DATA 11,640,480
480 DATA 12,640,480
490 DATA 13,320,200
