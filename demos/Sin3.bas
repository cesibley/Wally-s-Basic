10 REM TEXT SINE WAVE FAST USING LOCATE (NO SCROLL)
20 INPUT "ENTER NUMBER OF COLUMNS: "; COLS
30 IF COLS < 10 THEN COLS = 10
40 IF COLS > 80 THEN COLS = 80

50 ROWS = 24
60 AMPL = COLS / 2
70 CENTER = COLS / 2
80 PHASE = 0
85 SPEED 85

90 DIM OLDX(30)
100 FOR R = 1 TO ROWS
110 OLDX(R) = 0
120 NEXT R

130 CLS

140 REM MAIN LOOP
150 K$ = INKEY$
160 IF K$ = "q" THEN K$ = "Q"
170 IF K$ = "Q" THEN END

180 REM OPTIONAL STATUS LINE
190 LOCATE 25,1,0
200 PRINT "Q=QUIT   COLS="; COLS; "   PHASE="; PHASE; "      ";

210 FOR Y = 0 TO ROWS - 1
220 ROW = Y + 1

230 ANG = (Y / (ROWS - 1.0)) * 6.2831853 + PHASE
240 X = CENTER + AMPL * SIN(ANG)
250 X = INT(X)

260 IF X < 1 THEN X = 1
270 IF X > COLS THEN X = COLS

280 REM ERASE PREVIOUS STAR ON THIS ROW
290 IF OLDX(ROW) = 0 THEN GOTO 320
300 LOCATE ROW,OLDX(ROW),0
310 PRINT " ";

320 REM DRAW NEW STAR
330 LOCATE ROW,X,0
340 PRINT "*";

350 OLDX(ROW) = X
360 NEXT Y

370 PHASE = PHASE + 0.15

400 GOTO 150
