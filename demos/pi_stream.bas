10 REM PI STREAMING DIGIT DEMO (SPIGOT ALGORITHM)
20 REM PRINTS DIGITS AS THEY BECOME AVAILABLE
30 INPUT "NUMBER OF DECIMAL DIGITS: "; D
40 IF D < 1 THEN PRINT "DIGITS MUST BE >= 1": END

50 L = D * 10 \ 3
60 DIM A(L)
70 FOR I = 1 TO L
80 A(I) = 2
90 NEXT I

100 T0 = TIMER()
110 NINES = 0
120 PREDIGIT = 0
130 PRINT
140 PRINT "PI ~ ";

150 FOR J = 1 TO D + 2
160 Q = 0
170 FOR I = L TO 1 STEP -1
180 X = 10 * A(I) + Q * I
190 DEN = 2 * I - 1
200 A(I) = X MOD DEN
210 Q = X \ DEN
220 NEXT I

230 A(1) = Q MOD 10
240 Q = Q \ 10

250 IF J = 1 THEN
260 PREDIGIT = Q
270 ELSEIF Q = 9 THEN
280 NINES = NINES + 1
290 ELSEIF Q = 10 THEN
300 PRINT PREDIGIT + 1;
310 FOR K = 1 TO NINES
320 PRINT 0;
330 NEXT K
340 IF J = 2 THEN PRINT ".";
350 PREDIGIT = 0
360 NINES = 0
370 ELSE
380 PRINT PREDIGIT;
390 IF J = 2 THEN PRINT ".";
400 FOR K = 1 TO NINES
410 PRINT 9;
420 NEXT K
430 PREDIGIT = Q
440 NINES = 0
450 END IF
460 NEXT J

470 PRINT PREDIGIT;
480 PRINT
490 T1 = TIMER()
500 ELAPSED = T1 - T0
510 IF ELAPSED < 0 THEN ELAPSED = ELAPSED + 86400
520 PRINT "DIGITS SHOWN = "; D
530 PRINT "ELAPSED TIME = "; ELAPSED; " SECONDS"
540 END
