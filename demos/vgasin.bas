10 SCREEN 12
20 CLS
30 AMP = 100
40 FREQ = .04
50 YOFF = 240
60 STEP = .2
70 PHASE = 0
80 OLDPH = 0

90 GOSUB 2000

100 IF INKEY$ <> "" THEN END

110 ' erase old wave
120 COLOR 0
130 PH = OLDPH
140 GOSUB 3000

150 ' advance phase (this creates the scrolling illusion)
160 OLDPH = PHASE
170 PHASE = PHASE + STEP

180 ' draw new wave
190 COLOR 11
200 PH = PHASE
210 GOSUB 3000

220 ' timing
230 T! = TIMER
240 WHILE TIMER < T! + .01: WEND

250 GOTO 100

2000 ' initial draw
2010 COLOR 11
2020 PH = PHASE
2030 GOSUB 3000
2040 RETURN

3000 ' draw full wave at phase PH
3010 X = 0
3020 Y = INT(AMP * SIN(PH) + YOFF + .5)
3030 PSET (0, Y)

3040 FOR X = 1 TO 639
3050 A = (X * FREQ) + PH
3060 NY = INT(AMP * SIN(A) + YOFF + .5)
3070 DY = NY - Y
3080 GOSUB 4000
3090 Y = NY
3100 NEXT X
3110 RETURN

4000 ' draw 1 step right and DY up/down
4010 N$ = LTRIM$(STR$(ABS(DY)))
4030 IF DY < 0 THEN CMD$ = "R1U" + N$ ELSE CMD$ = "R1D" + N$
4040 DRAW CMD$
4050 RETURN
