10 REM TEXT SINE WAVE FAST USING LOCATE (HORIZONTAL SCROLL)
20 INPUT "ENTER AMPLITUDE (1-12): "; AMPL
30 IF AMPL < 1 THEN AMPL = 1
40 IF AMPL > 12 THEN AMPL = 12

50 COLS = 80
60 ROWS = 24
70 CENTER = ROWS / 2
80 PHASE = 0
85 SPEED 90
90 DIM OLDY(80)
100 FOR X = 1 TO COLS
110 OLDY(X) = 0
120 NEXT X

130 CLS

140 REM MAIN LOOP
150 K$ = INKEY$
160 IF K$ = "q" THEN K$ = "Q"
170 IF K$ = "Q" THEN END

180 REM STATUS LINE
190 LOCATE 25,1,0
200 PRINT "Q=QUIT   AMPL="; AMPL; "   PHASE="; PHASE; "      ";

210 FOR X = 1 TO COLS
220 ANG = (X / COLS) * 6.2831853 + PHASE
230 Y = CENTER + AMPL * SIN(ANG)
240 Y = INT(Y)

250 IF Y < 1 THEN Y = 1
260 IF Y > ROWS THEN Y = ROWS

270 REM ERASE PREVIOUS STAR IN THIS COLUMN
280 IF OLDY(X) = 0 THEN GOTO 310
290 LOCATE OLDY(X), X, 0
300 PRINT " ";

310 REM DRAW NEW STAR
320 LOCATE Y, X, 0
330 PRINT "*";

340 OLDY(X) = Y
350 NEXT X

360 PHASE = PHASE + 0.15
370 GOTO 150
