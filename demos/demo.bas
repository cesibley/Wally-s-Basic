10 CLS
20 GOSUB 1000
30 GOSUB 2000
40 CLS
50 LOCATE 10,10 : PRINT "DONE"
60 END
1000 CLS
1010 LOCATE 1,2 : PRINT "STARFIELD  (ESC stops)"
1020 X0=2 : Y0=4 : W=60 : H=18
1030 DIM SX(80), SY(80), SV(80)
1040 FOR I=1 TO 80
1050 SX(I)=X0+RND(1)*W
1060 SY(I)=Y0+RND(1)*H
1070 SV(I)=0.3+RND(1)*0.7
1080 NEXT I
1090 FOR F=1 TO 350
1100 FOR I=1 TO 80
1110 LOCATE INT(SY(I)),INT(SX(I)) : PRINT " ";
1120 SY(I)=SY(I)+SV(I)
1130 IF SY(I)>Y0+H THEN SY(I)=Y0 : SX(I)=X0+RND(1)*W
1140 LOCATE INT(SY(I)),INT(SX(I)) : PRINT "*";
1150 NEXT I
1160 LOCATE 24,2 : PRINT "FRAME ";F;"   ";
1170 GOSUB 9000
1180 NEXT F
1190 RETURN
2000 CLS
2010 LOCATE 1,2 : PRINT "BOUNCY BOX  (ESC stops)"
2020 LEFT=2 : TOP=4 : W=60 : H=18
2030 RIGHT=LEFT+W-1 : BOT=TOP+H-1
2040 DIM BX(4), BY(4)
2050 BX(1)=10 : BY(1)=6
2060 BX(2)=22 : BY(2)=6
2070 BX(3)=22 : BY(3)=12
2080 BX(4)=10 : BY(4)=12
2090 VX=1 : VY=1
2100 FOR F=1 TO 300
2110 FOR R=BY(1) TO BY(3)
2120 LOCATE R,BX(1) : PRINT STRING$(BX(2)-BX(1)+1," ")
2130 NEXT R
2140 FOR I=1 TO 4
2150 BX(I)=BX(I)+VX : BY(I)=BY(I)+VY
2160 NEXT I
2170 IF BX(1)<=LEFT+1 OR BX(2)>=RIGHT-1 THEN VX=-VX
2180 IF BY(1)<=TOP OR BY(3)>=BOT THEN VY=-VY
2190 LOCATE BY(1),BX(1) : PRINT "#";STRING$(BX(2)-BX(1)-1,"=");"#"
2200 FOR R=BY(1)+1 TO BY(3)-1
2210 LOCATE R,BX(1) : PRINT "|";STRING$(BX(2)-BX(1)-1," ");"|"
2220 NEXT R
2230 LOCATE BY(3),BX(1) : PRINT "#";STRING$(BX(2)-BX(1)-1,"=");"#"
2240 LOCATE 24,2 : PRINT "FRAME ";F;"   ";
2250 GOSUB 9000
2260 NEXT F
2270 RETURN
9000 FOR J=1 TO 2000 : X=J*J : NEXT J
9010 RETURN
