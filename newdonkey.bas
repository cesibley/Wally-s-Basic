1170 GOTO 1410
1180 REM (WBASIC) removed monitor/adapter warning block
1190 REM
1200 REM
1210 REM
1220 REM
1230 REM
1240 REM
1250 REM
1260 REM
1270 REM
1280 REM
1290 REM
1291 GOTO 1410
1292 REM (WBASIC) removed BASICA/PLAY check
1293 REM
1294 REM
1295 REM
1296 REM
1298 ON ERROR GOTO 0
1299 SCREEN 0,1:COLOR 7,0,0:CLS:END
1300 REM
1410 COLOR 0
1420 DEFINT A-Y
1440 SCREEN 1,0:COLOR 8,1
1450 DIM Q%(500)
1460 DIM D1%(150),D2%(150),C1%(200),C2%(200)
1470 DIM DNK%(300)
1480 GOSUB 1940
1490 GOSUB 1780
1500 CLS
1510 DIM B%(300)
1520 FOR I=2 TO 300:B%(I)=-16384+192:NEXT
1530 B%(0)=2:B%(1)=193
1540 REM
1550 CX=110:CLS
1590 LINE (0,0)-(305,199),,B
1600 LINE (6,6)-(97,195),1,BF
1610 LINE (183,6)-(305,195),1,BF
1620 LOCATE 3,5:PRINT "Donkey"
1630 LOCATE 5,5:PRINT "BASICA 1.10"
1640 LOCATE 7,5:PRINT "IBM Personal Computer"
1650 LOCATE 9,5:PRINT "Copyright IBM 1981"
1660 LOCATE 12,5:PRINT "Press any key"
1670 LOCATE 14,5:PRINT "to start"
1680 CY=CY-4:IF CY<60 THEN 2230
1690 PUT (CX,CY),CAR%,PRESET
1700 DX=105+42*INT(RND*2)
1710 FOR Y=(RND*-4)*8 TO 124 STEP 6
1720 REM (WBASIC) SOUND removed
1730 A$=INKEY$:IF A$=CHR$(27) THEN 1298 ELSE IF LEN(A$)>0 THEN LINE (CX,CY)-(CX+28,CY+44),0,BF:CX=252-CX:PUT (CX,CY),CAR%,PRESET
1740 IF Y=>3 THEN PUT (DX,Y),DNK%,PSET
1750 IF CX=DX AND Y+25>=CY THEN 2060
1760 NEXT
1770 GOTO 1680
1780 REM
1790 REM Draw the car
1800 CIRCLE (0,0),1,0
1810 PAINT (0,0),0,0
1820 LINE (0,0)-(27,0),0
1830 LINE (0,0)-(0,40),0
1840 LINE (27,0)-(27,40),0
1850 LINE (0,40)-(27,40),0
1860 GET (0,0)-(27,40),CAR%
1870 RETURN
1880 REM
1890 REM Donkey
1900 CIRCLE (0,0),1,0
1910 PAINT (0,0),0,0
1920 LINE (0,0)-(25,25),0,BF
1930 GET (0,0)-(25,25),DNK%
1940 REM
1950 REM Draw the barrels
1960 LINE (0,0)-(2,2),2,BF
1970 GET (0,0)-(2,2),D1%
1980 LINE (0,0)-(2,2),3,BF
1990 GET (0,0)-(2,2),D2%
2000 LINE (0,0)-(3,3),2,BF
2010 GET (0,0)-(3,3),C1%
2020 LINE (0,0)-(3,3),3,BF
2030 GET (0,0)-(3,3),C2%
2040 RETURN
2050 REM
2060 REM Crash
2070 LINE (CX,CY)-(CX+28,CY+44),0,BF
2080 PUT (CX,CY),CAR%,PRESET
2090 FOR I=1 TO 7
2100 D1X=CX-14+RND*28
2110 D1Y=CY+RND*40
2120 D2X=CX-14+RND*28
2130 D2Y=CY+RND*40
2140 FOR X=1 TO 25
2150 PUT (D1X,D1Y),C1%:PUT(D2X,D2Y),C2%
2160 PUT (D1X,D1Y),D1%:PUT(D2X,D1Y),D2%
2170 NEXT
2180 NEXT
2190 PUT (D1X,D1Y),D1%:PUT(D2X,D1Y),D2%
2200 NEXT
2210 FOR Y=1 TO 2000:NEXT
2220 GOTO 1298
2230 END
