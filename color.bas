10 REM ============================================
20 REM WBASIC COLOR TEST (FG / BG / BRIGHT)
30 REM ============================================

40 CLS
50 PRINT "STANDARD FOREGROUND COLORS (BG = BLACK)"
60 PRINT

70 FOR C = 0 TO 7
80   COLOR C, 0
90   PRINT "COLOR "; C; "  STANDARD"
100 NEXT C

110 COLOR
120 PRINT
130 PRINT "BRIGHT FOREGROUND COLORS (BG = BLACK)"
140 PRINT

150 FOR C = 8 TO 15
160   COLOR C, 0
170   PRINT "COLOR "; C; "  BRIGHT"
180 NEXT C

190 COLOR
200 PRINT
210 PRINT "BACKGROUND COLORS (FG = WHITE)"
220 PRINT

230 FOR B = 0 TO 7
240   COLOR 15, B
250   PRINT "FG 15  BG "; B
260 NEXT B

270 COLOR
280 PRINT
290 PRINT "MIXED FOREGROUND / BACKGROUND"
300 PRINT

310 FOR C = 1 TO 7
320   COLOR C, 7
330   PRINT "FG "; C; "  BG 7"
340 NEXT C

350 COLOR
360 PRINT
370 PRINT "RESET TO DEFAULT"
380 COLOR
390 PRINT "DEFAULT COLORS RESTORED"

400 PRINT
410 PRINT "END OF COLOR TEST"
420 END
