10 SCREEN 1: CLS
20 DRAW "BM+5,+5"
30 DRAW "R10;D10;L10;U10;"
40 IF POINT(165,105) <> 15 THEN PRINT "TEST FAIL: top-left corner": FAIL = FAIL + 1
50 IF POINT(175,105) <> 15 THEN PRINT "TEST FAIL: top-right corner": FAIL = FAIL + 1
60 IF POINT(175,115) <> 15 THEN PRINT "TEST FAIL: bottom-right corner": FAIL = FAIL + 1
70 IF POINT(165,115) <> 15 THEN PRINT "TEST FAIL: bottom-left corner": FAIL = FAIL + 1
80 SCREEN 0
90 PRINT "FAIL="; FAIL
100 IF FAIL > 0 THEN PRINT "TEST FAIL": END
110 PRINT "TEST PASS"
120 END
