10 REM =============================================================
20 REM ERASE / SWAP Torture Test (GW-BASIC strict)
30 REM =============================================================
40 DEFINT A-Z
50 PASS=0:FAIL=0
60 PRINT "Running ERASE/SWAP torture test..."
70 PRINT
80 ON ERROR GOTO 9000

90 ISSTR=0
100 EACT=0:EEXP=0
110 EACT$="":EEXP$=""
120 EMSG$=""
130 EXPECTING=0:EXP_ERR=0:EXP_ERL=0:XMSG$=""

1000 PRINT "TEST1: ERASE DIMmed array + re-DIM"
1010 DIM A(2)
1020 A(0)=11:A(1)=22:A(2)=33
1030 ERASE A
1040 DIM A(2)
1050 ISSTR=0:EACT=A(0):EEXP=0:EMSG$="After ERASE+DIM, A(0)=0":GOSUB 8000
1060 ISSTR=0:EACT=A(2):EEXP=0:EMSG$="After ERASE+DIM, A(2)=0":GOSUB 8000

1100 PRINT "TEST2: ERASE string array + re-DIM"
1110 DIM S$(1)
1120 S$(0)="HI":S$(1)="THERE"
1130 ERASE S$
1140 DIM S$(1)
1150 ISSTR=-1:EACT$=S$(0):EEXP$="":EMSG$="After ERASE+DIM, S$(0)=\"\"":GOSUB 8000

1200 PRINT "TEST3: SWAP numeric scalars"
1210 X=5:Y=-7:SWAP X,Y
1220 ISSTR=0:EACT=X:EEXP=-7:EMSG$="SWAP numeric: X":GOSUB 8000
1230 ISSTR=0:EACT=Y:EEXP=5:EMSG$="SWAP numeric: Y":GOSUB 8000

1300 PRINT "TEST4: SWAP string scalars"
1310 A$="ONE":B$="TWO":SWAP A$,B$
1320 ISSTR=-1:EACT$=A$:EEXP$="TWO":EMSG$="SWAP string: A$":GOSUB 8000
1330 ISSTR=-1:EACT$=B$:EEXP$="ONE":EMSG$="SWAP string: B$":GOSUB 8000

1400 PRINT "TEST5: SWAP array elements"
1410 DIM M(1)
1420 M(0)=10:M(1)=20
1430 SWAP M(0),M(1)
1440 ISSTR=0:EACT=M(0):EEXP=20:EMSG$="SWAP array elem: M(0)":GOSUB 8000
1450 ISSTR=0:EACT=M(1):EEXP=10:EMSG$="SWAP array elem: M(1)":GOSUB 8000

1500 PRINT "TEST6: SWAP scalar name even when same-name array exists"
1510 DIM Q(1)
1520 Q=77
1530 SWAP Q,Q
1540 ISSTR=0:EACT=Q:EEXP=77:EMSG$="SWAP Q,Q (scalar) allowed even when Q() DIMed":GOSUB 8000

1600 PRINT "TEST7: SWAP type mismatch should error"
1610 N=1:A$="X"
1620 EXPECTING=1:EXP_ERR=13:EXP_ERL=1630:XMSG$="SWAP N,A$ should type mismatch"
1630 SWAP N,A$
1640 IF EXPECTING=1 THEN EXPECTING=0:FAIL=FAIL+1:PRINT "FAIL:";XMSG$;" (no error)"

1700 PRINT
1710 PRINT "=================================="
1720 PRINT "ERASE/SWAP TORTURE TEST COMPLETE"
1730 PRINT "PASS=";PASS;" FAIL=";FAIL
1740 PRINT "=================================="
1750 END

8000 IF ISSTR THEN GOTO 8050
8010 IF EACT=EEXP THEN PASS=PASS+1:RETURN
8020 FAIL=FAIL+1:PRINT "FAIL:";EMSG$;" EXPECT=";EEXP;" GOT=";EACT:RETURN
8050 IF EACT$=EEXP$ THEN PASS=PASS+1:RETURN
8060 FAIL=FAIL+1:PRINT "FAIL:";EMSG$;" EXPECT=[";EEXP$;"] GOT=[";EACT$;"]":RETURN

9000 IF EXPECTING=1 THEN GOTO 9100
9010 PRINT "UNEXPECTED ERROR: ERR=";ERR;" ERL=";ERL
9020 END

9100 IF ERR=EXP_ERR AND ERL=EXP_ERL THEN PASS=PASS+1 ELSE FAIL=FAIL+1:PRINT "FAIL:";XMSG$;" expected ERR=";EXP_ERR;" ERL=";EXP_ERL;" got ERR=";ERR;" ERL=";ERL
9110 EXPECTING=0
9120 RESUME NEXT
