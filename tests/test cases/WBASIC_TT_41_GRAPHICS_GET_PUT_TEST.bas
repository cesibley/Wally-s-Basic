10 REM WBASIC_TT_41_GRAPHICS_GET_PUT_TEST
20 FAIL = 0
30 DIM B(200)
40 SCREEN 1
50 CLS
60 LINE (10,10)-(12,12),3,BF
70 GET (10,10)-(12,12),B
80 LINE (10,10)-(12,12),0,BF
90 PUT (20,20),B
100 IF POINT(20,20) <> 3 THEN PRINT "TEST FAIL: PUT copy top-left": FAIL = FAIL + 1
110 IF POINT(22,22) <> 3 THEN PRINT "TEST FAIL: PUT copy bottom-right": FAIL = FAIL + 1
120 IF POINT(19,19) <> 0 THEN PRINT "TEST FAIL: PUT copy leaked": FAIL = FAIL + 1
130 LINE (20,20)-(22,22),1,BF
140 PUT (20,20),B,OR
150 IF POINT(21,21) <> 3 THEN PRINT "TEST FAIL: PUT OR": FAIL = FAIL + 1
160 LINE (20,20)-(22,22),7,BF
170 PUT (20,20),B,AND
180 IF POINT(21,21) <> 3 THEN PRINT "TEST FAIL: PUT AND": FAIL = FAIL + 1
190 LINE (20,20)-(22,22),1,BF
200 PUT (20,20),B,XOR
210 IF POINT(21,21) <> 2 THEN PRINT "TEST FAIL: PUT XOR": FAIL = FAIL + 1
220 SCREEN 0
230 PRINT "FAIL="; FAIL
240 IF FAIL > 0 THEN PRINT "TEST FAIL": END
250 PRINT "TEST PASS"
260 END
