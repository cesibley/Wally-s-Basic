10 SCREEN 1: CLS
20 C = 6
30 S = 10
40 DRAW "BM+5,+5"
50 DRAW "R=S; D=S; L=S; U=S;"
60 IF POINT(165,105) <> C THEN PRINT "TEST FAIL: top-left corner": FAIL = FAIL + 1
70 IF POINT(175,105) <> C THEN PRINT "TEST FAIL: top-right corner": FAIL = FAIL + 1
80 IF POINT(175,115) <> C THEN PRINT "TEST FAIL: bottom-right corner": FAIL = FAIL + 1
90 IF POINT(165,115) <> C THEN PRINT "TEST FAIL: bottom-left corner": FAIL = FAIL + 1
100 SCREEN 0
110 PRINT "FAIL="; FAIL
120 IF FAIL > 0 THEN PRINT "TEST FAIL": END
130 PRINT "TEST PASS"
140 END
