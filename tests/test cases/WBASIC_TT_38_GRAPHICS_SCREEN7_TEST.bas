10 REM WBASIC_TT_38_GRAPHICS_SCREEN7_TEST
20 FAIL = 0
30 SCREEN 7
40 PSET (319,199), 15
50 IF POINT(319,199) <> 15 THEN PRINT "TEST FAIL: SCREEN7 max corner plot": FAIL = FAIL + 1
60 PSET (160,100), 4
70 IF POINT(160,100) <> 4 THEN PRINT "TEST FAIL: SCREEN7 center plot": FAIL = FAIL + 1
80 IF POINT(320,199) <> -1 THEN PRINT "TEST FAIL: SCREEN7 x out-of-range expected -1": FAIL = FAIL + 1
90 IF POINT(319,200) <> -1 THEN PRINT "TEST FAIL: SCREEN7 y out-of-range expected -1": FAIL = FAIL + 1
100 CLS
110 IF POINT(319,199) <> 0 THEN PRINT "TEST FAIL: SCREEN7 CLS did not clear": FAIL = FAIL + 1
120 SCREEN 0
130 PRINT "FAIL="; FAIL
140 IF FAIL > 0 THEN PRINT "TEST FAIL": END
150 PRINT "TEST PASS"
160 END
