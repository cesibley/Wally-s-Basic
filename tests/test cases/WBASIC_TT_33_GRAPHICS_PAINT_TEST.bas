10 REM WBASIC_TT_33_GRAPHICS_PAINT_TEST
20 REM Milestone G Path B: PAINT primitive in SCREEN 1 and SCREEN 2
30 FAIL = 0
40 SCREEN 1
50 LINE (5,5)-(20,5),2
60 LINE (20,5)-(20,20),2
70 LINE (20,20)-(5,20),2
80 LINE (5,20)-(5,5),2
90 PAINT (10,10),4
100 IF POINT(10,10) <> 4 THEN PRINT "TEST FAIL: SCREEN 1 PAINT fill": FAIL = FAIL + 1
110 IF POINT(5,5) <> 2 THEN PRINT "TEST FAIL: SCREEN 1 PAINT border overwrite": FAIL = FAIL + 1
120 IF POINT(0,0) <> 0 THEN PRINT "TEST FAIL: SCREEN 1 PAINT leaked outside": FAIL = FAIL + 1
130 SCREEN 2
140 LINE (100,50)-(140,50),3
150 LINE (140,50)-(140,90),3
160 LINE (140,90)-(100,90),3
170 LINE (100,90)-(100,50),3
180 PAINT (110,60),1
190 IF POINT(110,60) <> 1 THEN PRINT "TEST FAIL: SCREEN 2 PAINT fill": FAIL = FAIL + 1
200 IF POINT(100,50) <> 3 THEN PRINT "TEST FAIL: SCREEN 2 PAINT border overwrite": FAIL = FAIL + 1
210 IF POINT(99,49) <> 0 THEN PRINT "TEST FAIL: SCREEN 2 PAINT leaked outside": FAIL = FAIL + 1
220 SCREEN 0
230 PRINT "FAIL="; FAIL
240 IF FAIL > 0 THEN PRINT "TEST FAIL": END
250 PRINT "TEST PASS"
260 END
