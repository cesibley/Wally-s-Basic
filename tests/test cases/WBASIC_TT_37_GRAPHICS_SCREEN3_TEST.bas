10 REM WBASIC_TT_37_GRAPHICS_SCREEN3_TEST
20 FAIL = 0
30 SCREEN 3
40 PSET (639,399), 15
50 IF POINT(639,399) <> 15 THEN PRINT "TEST FAIL: SCREEN3 max corner plot": FAIL = FAIL + 1
60 PSET (320,200), 7
70 IF POINT(320,200) <> 7 THEN PRINT "TEST FAIL: SCREEN3 center plot": FAIL = FAIL + 1
80 IF POINT(640,399) <> -1 THEN PRINT "TEST FAIL: SCREEN3 x out-of-range expected -1": FAIL = FAIL + 1
90 IF POINT(639,400) <> -1 THEN PRINT "TEST FAIL: SCREEN3 y out-of-range expected -1": FAIL = FAIL + 1
100 CLS
110 IF POINT(639,399) <> 0 THEN PRINT "TEST FAIL: SCREEN3 CLS did not clear": FAIL = FAIL + 1
120 SCREEN 0
130 PRINT "FAIL="; FAIL
140 IF FAIL > 0 THEN PRINT "TEST FAIL": END
150 PRINT "TEST PASS"
160 END
