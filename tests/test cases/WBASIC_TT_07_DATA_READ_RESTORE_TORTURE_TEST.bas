10 REM ==========================================================
20 REM DATA / READ / RESTORE TORTURE TEST (GW-BASIC style)
30 REM Exercises:
40 REM  - DATA across many lines
50 REM  - Quoted strings with commas/colons/doubled quotes
60 REM  - Empty fields: "" and ,, (blank)
70 REM  - RESTORE and RESTORE <line>
80 REM  - Out of DATA trapping via ON ERROR (expects ERR=4)
90 REM ==========================================================

100 DEFINT A-Z
110 PASS=0: FAIL=0
120 ON ERROR GOTO 8000

130 PRINT "Running DATA/READ/RESTORE torture test..."
140 PRINT

150 GOSUB 1000
160 GOSUB 2000
170 GOSUB 3000
180 GOSUB 4000
190 GOSUB 5000

200 PRINT
210 PRINT "=================================="
220 PRINT "DATA/READ/RESTORE TORTURE TEST COMPLETE"
230 PRINT "PASS=";PASS;" FAIL=";FAIL
240 PRINT "=================================="
250 END

900 REM ASSERT NUMERIC
930 IF GOT=EXPECT THEN PASS=PASS+1 ELSE FAIL=FAIL+1: PRINT "FAIL:";DESC$;" EXPECT=";EXPECT;" GOT=";GOT
940 RETURN

950 REM ASSERT STRING
980 IF GOT$=EXPECT$ THEN PASS=PASS+1 ELSE FAIL=FAIL+1: PRINT "FAIL:";DESC$;" EXPECT=[";EXPECT$;"] GOT=[";GOT$;"]"
990 RETURN

1000 PRINT "TEST1: Basic READ order"
1040 RESTORE 9000
1050 READ A, B, C$
1060 GOT=A: EXPECT=11: DESC$="READ A=11": GOSUB 930
1070 GOT=B: EXPECT=-7: DESC$="READ B=-7": GOSUB 930
1080 GOT$=C$: EXPECT$="HELLO": DESC$="READ C$=HELLO": GOSUB 980
1090 RETURN

2000 PRINT "TEST2: Quoted strings"
2040 RESTORE 9010
2050 READ S$, T$, U$
2060 GOT$=S$: EXPECT$="A,B": DESC$="Quoted comma string": GOSUB 980
2070 GOT$=T$: EXPECT$="X:Y:Z": DESC$="Quoted colon string": GOSUB 980
2080 GOT$=U$: EXPECT$="HE said ""WOW""": DESC$="Doubled quotes": GOSUB 980
2090 RETURN

3000 PRINT "TEST3: Empty fields"
3040 RESTORE 9020
3050 READ E$, F$, G
3060 GOT$=E$: EXPECT$="": DESC$="Empty quoted string": GOSUB 980
3070 GOT$=F$: EXPECT$="": DESC$="Blank field to string becomes empty": GOSUB 980
3080 GOT=G: EXPECT=0: DESC$="Blank numeric field becomes 0": GOSUB 930
3090 RETURN

4000 PRINT "TEST4: RESTORE <line>"
4040 RESTORE 9030
4050 READ X, Y
4060 GOT=X: EXPECT=1: DESC$="RESTORE 9030 first X": GOSUB 930
4070 GOT=Y: EXPECT=2: DESC$="RESTORE 9030 then Y": GOSUB 930

4080 RESTORE 9040
4090 READ X, Y, Z
4100 GOT=X: EXPECT=3: DESC$="RESTORE 9040 X": GOSUB 930
4110 GOT=Y: EXPECT=4: DESC$="RESTORE 9040 Y": GOSUB 930
4120 GOT=Z: EXPECT=5: DESC$="RESTORE 9040 Z": GOSUB 930
4130 RETURN

5000 PRINT "TEST5: Out of DATA error trapping"
5040 RESTORE 9050
5050 READ Q, R
5060 GOT=Q: EXPECT=9: DESC$="Q=9": GOSUB 930
5070 GOT=R: EXPECT=10: DESC$="R=10": GOSUB 930

5080 TRAP=0: TRAPERR=0: TRAPERL=0
5090 READ W
5100 GOT=1: EXPECT=0: DESC$="Expected Out of DATA did NOT occur": GOSUB 930
5110 RETURN

8000 TRAP=1: TRAPERR=ERR: TRAPERL=ERL
8040 RESUME 8060

8060 GOT=TRAP: EXPECT=1: DESC$="Error trap fired": GOSUB 930
8070 GOT=TRAPERR: EXPECT=4: DESC$="ERR=4 Out of DATA": GOSUB 930
8080 GOT=TRAPERL: EXPECT=5090: DESC$="ERL points to failing READ line": GOSUB 930

8090 ERR=0
8100 ON ERROR GOTO 0
8110 ON ERROR GOTO 8000
8120 RETURN

9000 DATA 11, -7, "HELLO"
9010 DATA "A,B","X:Y:Z","HE said ""WOW"""
9020 DATA "", ,
9030 DATA 1,2
9040 DATA 3,4,5
9050 DATA 9,10
