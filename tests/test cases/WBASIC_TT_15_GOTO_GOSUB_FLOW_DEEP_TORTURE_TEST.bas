10 REM ============================================
20 REM GOTO / GOSUB FLOW (DEEP) TORTURE TEST
30 REM STRICT GW-BASIC FORMS (NO BLOCK IF)
40 REM NO REUSED LINE NUMBERS
50 REM ============================================
60 DEFINT A-Z
70 PASS=0: FAIL=0

90 PRINT "Running GOTO / GOSUB FLOW (DEEP) torture test..."

100 PRINT "TEST1: Forward + backward GOTO (no accidental overwrite)"
110 A=0
120 GOTO 160
130 A=999
140 GOTO 190
160 A=1
170 GOTO 190
180 A=777
190 IF A<>1 THEN PRINT "FAIL: GOTO flow EXPECT=1 GOT=";A: FAIL=FAIL+1 ELSE PASS=PASS+1

200 PRINT "TEST2: Nested GOSUB depth (no fall-through)"
210 X=0
220 GOSUB 5000
230 IF X<>3 THEN PRINT "FAIL: Nested GOSUB EXPECT=3 GOT=";X: FAIL=FAIL+1 ELSE PASS=PASS+1

300 PRINT "TEST3: GOTO escape from inside GOSUB"
310 Y=0
320 GOSUB 5100
330 IF Y<>1 THEN PRINT "FAIL: GOTO escape EXPECT=1 GOT=";Y: FAIL=FAIL+1 ELSE PASS=PASS+1

400 PRINT "TEST4: GOSUB inside FOR/NEXT loop (sum)"
410 S=0
420 FOR I=1 TO 5
430 GOSUB 5200
440 NEXT I
450 IF S<>15 THEN PRINT "FAIL: Loop GOSUB sum EXPECT=15 GOT=";S: FAIL=FAIL+1 ELSE PASS=PASS+1

500 PRINT "TEST5: RETURN without GOSUB should error (ERR=3)"
510 TRIPPED=0: LASTERR=0: LASTERL=0
520 ON ERROR GOTO 540
530 RETURN
536 PRINT "FAIL: RETURN without GOSUB did not error": FAIL=FAIL+1
537 GOTO 570

540 TRIPPED=1: LASTERR=ERR: LASTERL=ERL: ERR=0
550 RESUME 570

570 ON ERROR GOTO 0
580 IF TRIPPED=0 THEN PRINT "FAIL: No trap on invalid RETURN": FAIL=FAIL+1 ELSE PASS=PASS+1
590 IF LASTERR<>3 THEN PRINT "FAIL: RETURN w/o GOSUB ERR EXPECT=3 GOT=";LASTERR: FAIL=FAIL+1 ELSE PASS=PASS+1
600 IF LASTERL<>530 THEN PRINT "FAIL: RETURN w/o GOSUB ERL EXPECT=530 GOT=";LASTERL: FAIL=FAIL+1 ELSE PASS=PASS+1

700 PRINT "TEST6: Mixed flow (deterministic GOTO+GOSUB path)"
710 Z=0
720 GOSUB 5300
730 IF Z<>4 THEN PRINT "FAIL: Mixed flow EXPECT=4 GOT=";Z: FAIL=FAIL+1 ELSE PASS=PASS+1

800 PRINT
810 PRINT "=================================="
820 PRINT "GOTO / GOSUB FLOW (DEEP) TORTURE TEST COMPLETE"
830 PRINT "PASS=";PASS;" FAIL=";FAIL
840 PRINT "=================================="
850 END

