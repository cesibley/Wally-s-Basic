10 REM WBASIC_TT_28_GRAPHICS_BOOTSTRAP_TEST
20 REM Milestone C smoke: SCREEN/PSET/POINT/CLS behavior
30 FAIL = 0
40 SCREEN 1
50 IF POINT(0,0) <> 0 THEN PRINT "TEST FAIL: SCREEN 1 did not clear to color 0": FAIL = FAIL + 1
60 PSET (10,10), 3
70 IF POINT(10,10) <> 3 THEN PRINT "TEST FAIL: PSET/POINT mismatch at (10,10)": FAIL = FAIL + 1
80 PSET (159,99), 15
90 IF POINT(159,99) <> 15 THEN PRINT "TEST FAIL: PSET/POINT mismatch at (159,99)": FAIL = FAIL + 1
100 IF POINT(-1,0) <> -1 THEN PRINT "TEST FAIL: POINT out-of-range expected -1": FAIL = FAIL + 1
110 CLS
120 IF POINT(10,10) <> 0 THEN PRINT "TEST FAIL: CLS did not clear graphics buffer": FAIL = FAIL + 1
130 SCREEN 0
140 PRINT "FAIL="; FAIL
150 IF FAIL > 0 THEN PRINT "TEST FAIL": END
160 PRINT "TEST PASS"
170 END
