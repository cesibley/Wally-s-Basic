10 REM WBASIC_TT_35_GRAPHICS_TEXT_OVERLAY_SCREEN2_TEST
20 FAIL = 0
30 SCREEN 2
40 PSET (100,50), 1
50 IF POINT(100,50) <> 1 THEN PRINT "TEST FAIL: setup point mismatch": FAIL = FAIL + 1
60 PRINT "OVERLAY SCREEN2"
70 LOCATE 10,30
80 PRINT "STATUS"
90 IF POINT(100,50) <> 1 THEN PRINT "TEST FAIL: POINT changed after overlay text": FAIL = FAIL + 1
100 COLOR 12,0
110 LOCATE 11,30
120 PRINT "HUD"
130 IF POINT(100,50) <> 1 THEN PRINT "TEST FAIL: POINT changed after COLOR/PRINT": FAIL = FAIL + 1
140 CLS
150 IF POINT(100,50) <> 0 THEN PRINT "TEST FAIL: CLS did not clear graphics to current BG": FAIL = FAIL + 1
160 SCREEN 0
170 PRINT "FAIL="; FAIL
180 IF FAIL > 0 THEN PRINT "TEST FAIL": END
190 PRINT "TEST PASS"
200 END
